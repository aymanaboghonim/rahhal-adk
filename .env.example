# Copy this file to .env at the repo root (next to README.md) and add your key.
# In a GitHub Codespace you can skip this file and use the Codespaces secret GOOGLE_API_KEY instead.
#
# Get the key from Google AI Studio, in a project WITHOUT billing, so it stays on the free tier.
# Never commit .env (it is git-ignored).

# Use the Gemini API with an AI Studio key, not Vertex AI.
GOOGLE_GENAI_USE_ENTERPRISE=0
GOOGLE_API_KEY=

# The model. Gemini 3.5 Flash-Lite: 15 requests/minute, 500 requests/day on the free tier (checked 2026-11-25).
RAHHAL_MODEL=gemini-3.5-flash-lite
